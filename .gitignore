# OS / tooling
.DS_Store

# macOS custom folder icons. The real filename is "Icon" followed by a carriage
# return, and a literal CR in this file gets eaten as the line ending - so match
# it with "?" instead. `cp -R` drags these along from Finder-customized folders.
Icon?

# Live knowledge-base content must never be published - only the empty scaffold
# is tracked here. These are inert while ~/.claude/knowledge holds the real KB
# and only its conventions are symlinked in; uncomment if that ever changes.
# knowledge/pages/**
# knowledge/experiences/**
# knowledge/raw/**
!knowledge/**/.gitkeep
!knowledge/raw/README.md

# Personal skills that must never be published. They live in a private local
# folder and are symlinked into ~/.claude/skills, never into this repo. The rule is
# here in case one gets copied by mistake.
skills/write-as-agnostic/

# Python bytecode
__pycache__/

# Files Claude Code writes into a mod's folder when it loads the mod from there
# (its API types and a tsconfig that extends them). Regenerated on every load.
/mods/*/.claude-plugin/types/
/mods/*/tsconfig.json
